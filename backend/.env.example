# Copy to .env on the EC2 box (chmod 600). Never commit the real file.

PORT=3005

# openssl rand -hex 32
JWT_SECRET=

# npm run hash -- 'your-admin-password'
ADMIN_PASSWORD_HASH=

# Origins allowed to call this API: the admin console AND the public site,
# since the application form posts here too. Comma-separated.
ADMIN_ORIGINS=https://pratyushadmin.edastra.in,https://pratyushfitness.edastra.in

# Fine-grained PAT for Ed-Astra-Solutions/pratyush with repository permissions:
#   Contents: Read and write     (commit content + image uploads)
#   Actions:  Read and write     (manual rebuild + build status in the console)
GITHUB_TOKEN=
GITHUB_OWNER=Ed-Astra-Solutions
GITHUB_REPO=pratyush
GITHUB_BRANCH=main
GITHUB_WORKFLOW=deploy.yml

CONTENT_PATH=frontend/content/site.json
IMAGE_DIR=frontend/images

COMMITTER_NAME=PL Admin Console
COMMITTER_EMAIL=admin@pratyushliftz.com
SESSION_HOURS=12

# Where coaching applications are stored. systemd's StateDirectory creates
# and owns this; leads never leave the instance.
DATA_DIR=/var/lib/pl-admin-api

# Optional: any endpoint that accepts {"text": "..."} — Slack or Discord
# incoming webhook — pinged on each new application.
NOTIFY_WEBHOOK=

# A form completed faster than this is filed as spam (recoverable in the console).
MIN_FILL_SECONDS=8
